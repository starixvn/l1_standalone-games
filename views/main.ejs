<!DOCTYPE html>
<html style="height: 100%; margin: 0">
  <head>
    <style>
      body {
        height: 100%;
        margin: 0;
        overflow: hidden;
      }
      iframe {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
      }
    </style>
  </head>
  <body>
    <iframe
      src="<%= url %>"
      allow="fullscreen; clipboard-read; clipboard-write"
    ></iframe>
  </body>
</html>
