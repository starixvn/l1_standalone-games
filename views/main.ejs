<!DOCTYPE html>
<html style="margin: 0; padding: 0; height: 100%; overflow: hidden">
  <head>
    <style>
      body {
        margin: 0;
        padding: 0;
        height: 100vh;
        overflow: hidden;
      }
      iframe {
        border: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <iframe src="<%= url %>" width="100%" height="100%"></iframe>
  </body>
</html>
